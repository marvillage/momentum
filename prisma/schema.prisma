// Momentum — personal daily operator
// Multi-user: every top-level row is owned by a User. Existing data is migrated
// to the seeded "kush" account. userId is nullable only to allow a clean
// migration over pre-existing rows; application code always sets it.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id           String         @id @default(cuid())
  username     String         @unique
  passwordHash String
  name         String?
  timezone     String         @default("Asia/Kolkata")
  onboarded    Boolean        @default(false)
  lastRank     String? // last rank label seen, for rank-up celebration
  createdAt    DateTime       @default(now())
  groups       Group[]
  activities   Activity[]
  tasks        TaskInstance[]
  gymExercises GymExercise[]
  bodyWeights  BodyWeight[]
  channels     Channel[]
  foodLogs     FoodLog[]
  workouts     WorkoutRating[]
  savedMeals   SavedMeal[]
  waterLogs    WaterLog[]
  setLogs      SetLog[]
  pushSubs     PushSubscription[]
  settings     Settings?
}

// A browser/device push subscription (Web Push).
model PushSubscription {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  endpoint  String   @unique
  p256dh    String
  auth      String
  createdAt DateTime @default(now())

  @@index([userId])
}

// A logged working set: what you actually lifted on a given day.
model SetLog {
  id        String   @id @default(cuid())
  userId    String?
  user      User?    @relation(fields: [userId], references: [id], onDelete: Cascade)
  date      String // YYYY-MM-DD
  exercise  String // denormalized name (survives exercise edits/deletes)
  reps      Int
  weight    Float
  createdAt DateTime @default(now())

  @@index([userId, date])
}

// A reusable meal the user has logged before — one-tap quick-add.
model SavedMeal {
  id        String   @id @default(cuid())
  userId    String?
  user      User?    @relation(fields: [userId], references: [id], onDelete: Cascade)
  name      String
  kcal      Int      @default(0)
  protein   Int      @default(0)
  carbs     Int      @default(0)
  uses      Int      @default(0)
  createdAt DateTime @default(now())

  @@index([userId])
}

// Water intake events (each ~a glass); summed per day.
model WaterLog {
  id        String   @id @default(cuid())
  userId    String?
  user      User?    @relation(fields: [userId], references: [id], onDelete: Cascade)
  date      String
  ml        Int
  createdAt DateTime @default(now())

  @@index([userId, date])
}

// Post-workout intensity rating (1–5), one per day.
model WorkoutRating {
  id        String   @id @default(cuid())
  userId    String?
  user      User?    @relation(fields: [userId], references: [id], onDelete: Cascade)
  date      String // YYYY-MM-DD
  intensity Int // 1..5
  createdAt DateTime @default(now())

  @@unique([userId, date])
  @@index([userId])
}

// A navbar section / customizable grouping of activities ("Coding", "Gym", "Writing").
model Group {
  id         String     @id @default(cuid())
  userId     String?
  user       User?      @relation(fields: [userId], references: [id], onDelete: Cascade)
  name       String
  slug       String
  icon       String? // emoji shown in the navbar
  kind       String     @default("NORMAL") // NORMAL | GYM | FOOD
  sortOrder  Int        @default(0)
  activities Activity[]
  createdAt  DateTime   @default(now())

  @@unique([userId, slug])
}

// A recurring thing you do: "LeetCode 4/day", "Striver course", "Gym", "Medium 3/week".
model Activity {
  id           String         @id @default(cuid())
  userId       String?
  user         User?          @relation(fields: [userId], references: [id], onDelete: Cascade)
  slug         String
  area         String // DSA | ML | CAREER | WRITING | X | MATIKS | GYM | SKIN | HABIT
  type         String         @default("SIMPLE") // SIMPLE | PROBLEMS | VIDEO | GYM | WEEKLY
  name         String
  icon         String?
  link         String? // a quick-open link for this activity (e.g. the doc you're writing)
  groupId      String?
  group        Group?         @relation(fields: [groupId], references: [id], onDelete: SetNull)
  cadence      String         @default("DAILY") // DAILY | WEEKDAYS | WEEKLY | DAYS | EVERY_N
  daysOfWeek   String? // CSV of 1..7 (Mon..Sun) — weekly days when cadence = DAYS
  biweeklyDays String? // CSV of 1..7 — days that fire every OTHER week (publishing)
  everyNDays   Int? // when cadence = EVERY_N
  durationMin  Int? // optional time box per occurrence, in minutes
  targetCount  Int            @default(1)
  minCount     Int? // e.g. LeetCode min 3
  weeklyTarget Int? // e.g. Medium 3/week
  unit         String? // "questions" | "video" | "story" ...
  active       Boolean        @default(true)
  rollover     Boolean        @default(true) // unfinished days roll to backlog; if false they just lapse
  sortOrder    Int            @default(0)
  meta         String? // JSON blob for module-specific config
  items        Item[]
  tasks        TaskInstance[]
  createdAt    DateTime       @default(now())

  @@unique([userId, slug])
  @@index([groupId])
}

// Ordered catalog content fed into an Activity: a Striver problem, an ML video, an LLD pattern.
model Item {
  id         String         @id @default(cuid())
  activityId String
  activity   Activity       @relation(fields: [activityId], references: [id], onDelete: Cascade)
  title      String
  url        String?
  order      Int            @default(0)
  done       Boolean        @default(false)
  meta       String?
  tasks      TaskInstance[]
  createdAt  DateTime       @default(now())

  @@index([activityId])
}

// One generated occurrence for a date — the heart of the planner + backlog.
model TaskInstance {
  id          String    @id @default(cuid())
  userId      String?
  user        User?     @relation(fields: [userId], references: [id], onDelete: Cascade)
  activityId  String
  activity    Activity  @relation(fields: [activityId], references: [id], onDelete: Cascade)
  itemId      String?
  item        Item?     @relation(fields: [itemId], references: [id])
  date        String // YYYY-MM-DD (the day it's scheduled for)
  status      String    @default("PENDING") // PENDING | DONE | SKIPPED
  count       Int       @default(0) // progress toward target
  carriedFrom String? // original date if rolled into backlog
  note        String?
  completedAt DateTime?
  sets        GymSet[]
  createdAt   DateTime  @default(now())

  @@index([userId, date])
  @@index([date])
  @@index([activityId, date])
}

model GymSet {
  id        String       @id @default(cuid())
  taskId    String
  task      TaskInstance @relation(fields: [taskId], references: [id], onDelete: Cascade)
  exercise  String
  setNo     Int
  reps      Int
  weight    Float
  createdAt DateTime     @default(now())
}

// Your prescribed split: which exercises (with target weight) on which weekday.
model GymExercise {
  id        String   @id @default(cuid())
  userId    String?
  user      User?    @relation(fields: [userId], references: [id], onDelete: Cascade)
  dow       Int // 1 = Mon ... 7 = Sun
  name      String
  sets      Int      @default(3)
  reps      Int      @default(8)
  weight    Float    @default(0)
  order     Int      @default(0)
  createdAt DateTime @default(now())

  @@index([userId, dow])
}

model BodyWeight {
  id        String   @id @default(cuid())
  userId    String?
  user      User?    @relation(fields: [userId], references: [id], onDelete: Cascade)
  date      String
  kg        Float
  createdAt DateTime @default(now())

  @@index([userId])
}

model Channel {
  id        String   @id @default(cuid())
  userId    String?
  user      User?    @relation(fields: [userId], references: [id], onDelete: Cascade)
  kind      String // TELEGRAM | EMAIL | WEBPUSH
  target    String // chat id | email | subscription JSON
  enabled   Boolean  @default(true)
  createdAt DateTime @default(now())
}

model Settings {
  id            String @id @default(cuid())
  userId        String @unique
  user          User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  timezone      String @default("Asia/Kolkata")
  morningPush   String @default("07:30")
  eveningPush   String @default("21:00")
  kcalTarget    Int    @default(2200)
  proteinTarget Int    @default(140)
  carbsTarget   Int    @default(250)
  waterTargetMl Int    @default(3000)
}

// A manually-logged food entry. You type the food + its kcal & protein.
model FoodLog {
  id        String   @id @default(cuid())
  userId    String?
  user      User?    @relation(fields: [userId], references: [id], onDelete: Cascade)
  date      String // YYYY-MM-DD in app timezone
  bucket    String // BREAKFAST | LUNCH | SNACK | DINNER
  name      String
  kcal      Int      @default(0)
  protein   Int      @default(0)
  carbs     Int      @default(0)
  createdAt DateTime @default(now())

  @@index([userId, date])
}
